def curata_issues(text):
    text = re.sub(r'^\[|\]$', '', text) # curatare paranteze drepte la inceput sau sfarsitul textului
    
    # lista de cuvinte irelevante
    cuvinte_de_sters = ['Alabama', 'Alaska', 'Arizona']  # DE ADAUGAT tot ce să dispară
    
    # construire regex de tip: \b(Alabama|Alaska|...)\b
    regex_sters = r'\b(' + '|'.join(cuvinte_de_sters) + r')\b'
    
    # aplicare stergere (case insensitive cu re.IGNORECASE)
    text = re.sub(regex_sters, '', text, flags=re.IGNORECASE)
    
    #curatare dupa stergere
    text = re.sub(r',\s*,', ',', text) # virgule duble devin una 
    text = re.sub(r'^[\s,]+|[\s,]+$', '', text) # virgule/spatii la inceput sau final
    
    return text.strip()